{
  "id": "soundgo",
  "name": "SoundGo",
  "version": "0.1.2",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "soundcloud.com",
      "*.soundcloud.com",
      "api-v2.soundcloud.com",
      "api-auth.soundcloud.com",
      "secure.soundcloud.com",
      "*.sndcdn.com",
      "*.soundcloud.cloud",
      "lrclib.net"
    ],
    "process": [
      "bin/hls-helper*"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "builtin": "liked"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "Following",
      "page": "following",
      "icon": "artist"
    }
  ]
}
